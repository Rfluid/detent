[Unit]
Description=Detent mouse daemon (Logitech HID++)
Documentation=man:detentd(1) https://github.com/Rfluid/detent
# Device access (uaccess) belongs to the active graphical session; start and stop with it.
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=exec
# Installed by scripts/install.sh (`just install` or a release tarball's install.sh).
ExecStart=%h/.local/bin/detentd
# Safety net: if the daemon ever dies without cleaning up, give the buttons back.
ExecStopPost=-%h/.local/bin/detentctl reset --quiet
Restart=on-failure
RestartSec=1
Slice=session.slice
NoNewPrivileges=yes
LockPersonality=yes

[Install]
WantedBy=graphical-session.target
